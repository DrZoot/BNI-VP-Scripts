<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Notable Networker Award - {{winner_name}}</title>
  <style>
    @page {
      size: letter landscape;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    html, body {
      width: 11in;
      height: 8.5in;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, "Liberation Sans", "Helvetica Neue", Helvetica, sans-serif;
      color: #65676b;
    }

    .certificate {
      position: relative;
      width: 11in;
      height: 8.5in;
      overflow: hidden;
      background: #fff url("assets/cert_bkg.jpg") center / 100% 100% no-repeat;
    }

    .award-content {
      position: absolute;
      top: 3.98in;
      right: 0.45in;
      left: 0.45in;
      text-align: center;
    }

    .winner-name {
      margin: 0;
      color: #65676b;
      font-size: 46pt;
      font-weight: 700;
      line-height: 1.05;
    }

    .for-label {
      margin: 0.26in 0 0.08in;
      color: #65676b;
      font-size: 15pt;
      font-weight: 400;
      letter-spacing: 0.3pt;
    }

    .award-line {
      margin: 0;
      color: #d7192a;
      font-size: 32pt;
      font-weight: 700;
      line-height: 1.08;
    }

    .footer {
      position: absolute;
      bottom: 0.48in;
      left: 0.48in;
      color: #65676b;
    }

    .footer-message {
      margin: 0 0 0.12in;
      font-size: 23pt;
      font-weight: 400;
      line-height: 1;
    }

    .footer-detail {
      margin: 0;
      font-size: 15pt;
      line-height: 1.22;
    }
  </style>
</head>
<body>
  <main class="certificate">
    <section class="award-content">
      <h1 class="winner-name">{{winner_name}}</h1>
      <p class="for-label">FOR</p>
      <p class="award-line">{{award_line}}</p>
    </section>
    <footer class="footer">
      <p class="footer-message">Growing Forward Together</p>
      <p class="footer-detail">{{award_month}}</p>
      <p class="footer-detail">{{president_name}}, Chapter President</p>
    </footer>
  </main>
</body>
</html>
